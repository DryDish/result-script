{
	"name": "result-script",
	"version": "1.0.2",
	"description": "Typescript implementation of Rust's Result",
	"main": "lib/cjs/index.js",
	"module": "lib/mjs/index.js",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"import": "./lib/mjs/index.js",
			"require": "./lib/cjs/index.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "rm -fr lib && bun run build:mjs && bun run build:cjs && bun run build:types && bun run fixup",
		"fixup": "echo '{\"type\": \"commonjs\"}' > lib/cjs/package.json && echo '{\"type\": \"module\"}' > lib/mjs/package.json",
		"build:mjs": "bun build ./src/index.ts --outdir ./lib/mjs --target node --format esm --splitting",
		"build:cjs": "bun build ./src/index.ts --outdir ./lib/cjs --target node --format cjs --splitting",
		"lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
		"build:types": "tsc -p tsconfig-types.json",
		"test": "vitest --run --bail 1",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/DryDish/typescript-result.git"
	},
	"keywords": [
		"typescript",
		"result",
		"rust"
	],
	"author": "AlexM",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/DryDish/typescript-result/issues"
	},
	"homepage": "https://github.com/DryDish/typescript-result#readme",
	"devDependencies": {
		"@types/bun": "^1.2",
		"@typescript-eslint/eslint-plugin": "^8",
		"@typescript-eslint/parser": "^8",
		"eslint": "^8",
		"typescript": "^5",
		"vitest": "^4.0.16"
	}
}
